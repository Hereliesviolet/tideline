# Template for worker/.env (loaded via env_file in docker-compose.yml).
# Copy to worker/.env and replace the placeholders. Never commit real values.

# Runtime
TZ=Europe/Berlin
PORT=9100
NODE_ENV=production

# Database (compose service "db"); the password must equal POSTGRES_PASSWORD in the root .env
DATABASE_URL=postgresql://capacity:<POSTGRES_PASSWORD>@db:5432/capacity?schema=public

# Redis (compose service "redis"); the password must equal REDIS_PASSWORD in the root .env
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# MOCO API (https://www.mocoapp.com)
MOCO_BASE_URL=https://<your-subdomain>.mocoapp.com/api/v1
MOCO_API_TOKEN=

# SMTP for 2FA, invitation and password-reset mails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Public URL of the dashboard (used for links in mails and as an allowed CORS origin)
FRONTEND_URL=http://localhost:8080

# Random, at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Optional - defaults are set in code
JWT_EXPIRES_IN=24h
SYNC_ENABLED=true
MOCO_PER_PAGE=100
